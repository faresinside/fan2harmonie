{
  "name": "fan2harmonie",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "postinstall": "node scripts/copy-cms.mjs",
    "predev": "node scripts/copy-cms.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/copy-cms.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "verifier:mise-en-ligne": "vitest run --config vitest.deploy.config.ts",
    "verifier:contenu": "vitest run --config vitest.content.config.ts",
    "test:docs": "vitest run --config vitest.docs.config.ts",
    "test:e2e": "playwright test",
    "test:php": "docker compose run --rm php php tests/php/run.php",
    "test:php81": "docker compose run --rm php81 php tests/php/run.php",
    "test:apache": "docker compose --profile apache up --build --force-recreate --attach apache-tests --abort-on-container-exit --exit-code-from apache-tests apache apache-sans-rewrite apache-sans-headers apache-sans-refus-rewrite apache-tests && docker compose --profile apache down --remove-orphans || (docker compose --profile apache down --remove-orphans && exit 1)",
    "check": "astro check",
    "lighthouse": "node scripts/lighthouse.mjs",
    "assets": "node scripts/prepare-assets.mjs"
  },
  "dependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@fontsource-variable/cormorant": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.0",
    "@fontsource/allura": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@sveltia/cms": "0.228.0",
    "astro": "5.18.2",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "devDependencies": {
    "yaml": "2.9.1"
  }
}
