# Dossier api/ : script du formulaire de contact. S'ajoute aux règles de la racine (../.htaccess), dont les
# refus (lib/, config*.php, *.sample.php, fichiers cachés…) s'appliquent aussi ici : ce fichier n'utilise
# volontairement pas mod_rewrite, sinon les règles de réécriture de la racine ne seraient plus héritées.

# Corps de requête limité à 64 Ko. Le script refuse lui-même au-delà de 56 Ko (pire cas d'un envoi sans
# JavaScript ≈ 45 Ko) ; PHP au-delà de 72 Ko (.user.ini).
LimitRequestBody 65536

# Pas de liste du contenu du dossier, pas de négociation de contenu ; pas de « chemin en plus » après le nom
# du script (/api/contact.php/x → 404).
Options -Indexes -MultiViews
AcceptPathInfo Off

# Seul contact.php peut être exécuté.
<FilesMatch "(?i)^(?!contact\.php$).*\.(php[0-9s]?|phtml|phar|pht)$">
    Require all denied
</FilesMatch>

# Réponses jamais gardées en cache.
<IfModule mod_headers.c>
    Header always set Cache-Control "no-store"
</IfModule>
