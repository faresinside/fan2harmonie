---
/**
 * Page unique : Accueil, Prochains rendez-vous, La pratique, Le Qi Gong, Qui est Fan 2 Harmonie,
 * Actualités, Contact. Les textes viennent de la collection « pages » (modifiables dans l'administration).
 * Rendez-vous et actualités sont choisis à la construction du site (`new Date()`) : la reconstruction
 * quotidienne retire les rendez-vous passés ; src/scripts/rendezvous.ts les masque aussi le jour même dans le
 * navigateur. Sans aucune actualité, la section et son lien disparaissent.
 */
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import RdvList from '../components/RdvList.astro';
import ActualiteCard from '../components/ActualiteCard.astro';
import LienCarte from '../components/LienCarte.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import IconSilhouette from '../components/IconSilhouette.astro';
import IconSouffle from '../components/IconSouffle.astro';
import IconLotus from '../components/IconLotus.astro';
import { upcoming } from '../lib/rendezvous';
import { resoudreLieu } from '../lib/lieu';
import { dernieresActualites } from '../lib/actualites';

async function page(id: 'pratique' | 'qigong' | 'parcours') {
  const entree = await getEntry('pages', id);
  if (!entree) throw new Error(`Texte manquant : src/content/pages/${id}.md`);
  const { Content } = await render(entree);
  return { titre: entree.data.titre, Content };
}

const [pratique, qigong, parcours] = await Promise.all([page('pratique'), page('qigong'), page('parcours')]);

// Lieu habituel (réglages) : nom, coordonnées et indications d'accès. Une séance sans lieu propre s'y tient.
const lieuEntree = await getEntry('reglagesLieu', 'lieu');
if (!lieuEntree) throw new Error('Réglages manquants : src/content/reglages/lieu.md');
const { Content: IndicationsLieu } = await render(lieuEntree);
const lieu = lieuEntree.data;

// Textes de l'accueil (réglages) : accroche, titre, infos, bouton et bienfaits.
const accueilEntree = await getEntry('reglagesAccueil', 'accueil');
if (!accueilEntree) throw new Error('Texte manquant : src/content/reglages/accueil.md');
const accueil = accueilEntree.data;
/** Indications d'accès (corps du fichier) : le bloc n'apparaît que si Stéphanie en a écrit. */
const avecIndications = Boolean(lieuEntree.body?.trim());

// Lieu résolu une fois pour toutes : liste des rendez-vous et données structurées affichent le même nom.
const rendezvous = upcoming(
  (await getCollection('rendezvous')).map((r) => r.data),
  new Date(),
).map((r) => ({ ...r, lieu: resoudreLieu(r.lieu, lieu.nom) }));

const actualites = await Promise.all(
  dernieresActualites(await getCollection('actualites')).map(async (a) => ({
    ...a.data,
    Content: (await render(a)).Content,
  })),
);
---

<Base
  titre="Fan 2 Harmonie — Qi Gong au parc de Rambouillet"
  description="Qi Gong gratuit en plein air au parc de Rambouillet, les samedis ou dimanches à 16h00. Accessible à tous, à tout âge et à tous niveaux."
  seances={rendezvous.map((r) => ({
    date: r.date.toISOString().slice(0, 10),
    heure: r.heure,
    lieu: r.lieu,
    remarque: r.remarque,
    annule: r.annule,
  }))}
>
  <Header actualites={actualites.length > 0} />

  <main id="contenu" tabindex="-1">
    <Hero accueil={accueil} />

    <Section id="rdv" titre="Prochains rendez-vous" accent="Rejoignez-moi" ton="chaud" mise="centree">
      <RdvList items={rendezvous} />
    </Section>

    <Section id="pratique" titre={pratique.titre} accent="au cœur de la nature">
      <IconSilhouette slot="illustration" />
      <div class="prose">
        <pratique.Content />
      </div>
      <LienCarte gps={{ lat: lieu.latitude, lon: lieu.longitude }}>
        {
          avecIndications && (
            <div class="prose">
              <IndicationsLieu />
            </div>
          )
        }
      </LienCarte>
    </Section>

    <Section id="qigong" titre={qigong.titre} accent="le souffle vital" ton="chaud">
      <IconSouffle slot="illustration" />
      <div class="prose">
        <qigong.Content />
      </div>
    </Section>

    <Section id="qui" titre={parcours.titre} accent="un projet qui me ressemble">
      <IconLotus slot="illustration" />
      <div class="prose">
        <parcours.Content />
      </div>
    </Section>

    {
      actualites.length > 0 && (
        <Section id="actualites" titre="Actualités" ton="chaud" mise="centree">
          <div class="actualites">
            {actualites.map(({ titre, date, image, Content }) => (
              <ActualiteCard titre={titre} date={date} image={image}>
                <Content />
              </ActualiteCard>
            ))}
          </div>
        </Section>
      )
    }

    <Section id="contact" titre="Contactez-moi" accent="une question ?" mise="centree">
      <ContactForm />
    </Section>
  </main>

  <Footer />

  <script>
    // Rendez-vous passés depuis la construction : masqués dans le navigateur (src/scripts/rendezvous.ts).
    import { appliquerDates } from '../scripts/rendezvous';

    appliquerDates(document);
  </script>
</Base>

<style>
  .actualites {
    max-width: 42rem;
    margin-inline: auto;
  }
</style>
