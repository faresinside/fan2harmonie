---
/**
 * Questions fréquentes (réglages « Page d'accueil ») : une question par bloc <details>/<summary>, repliée au départ,
 * ouverte au clic, à Entrée ou à Espace sans aucun script. Rien n'est rendu sans question. Les mêmes textes sont
 * décrits à Google dans les données structurées (FAQPage, src/lib/jsonld.ts) : ce qu'on lit est ce que Google lit.
 */
import type { QuestionFaq } from '../lib/jsonld';

interface Props {
  items: QuestionFaq[];
}

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <div class="faq">
      <h3 class="faq__titre">Questions fréquentes</h3>
      {items.map(({ question, reponse }) => (
        <details class="faq__question">
          <summary>{question}</summary>
          <p class="faq__reponse">{reponse}</p>
        </details>
      ))}
    </div>
  )
}

<style>
  .faq {
    max-width: var(--mesure);
    margin-top: var(--s-6);
  }

  .faq__titre {
    margin-bottom: var(--s-2);
    font-size: var(--fs-lg);
  }

  .faq__question {
    border-top: 1px solid var(--filet);
  }

  .faq__question:last-child {
    border-bottom: 1px solid var(--filet);
  }

  .faq__question summary {
    position: relative;
    padding: var(--s-2) var(--s-5) var(--s-2) 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .faq__question summary::-webkit-details-marker {
    display: none;
  }

  /* Plus / moins dessinés en CSS : décoratifs, l'état est annoncé par <details>. */
  .faq__question summary::after {
    content: '+';
    position: absolute;
    top: var(--s-2);
    right: var(--s-1);
    color: var(--rose-fonce);
    font-weight: 400;
  }

  .faq__question[open] summary::after {
    content: '\2212';
  }

  .faq__reponse {
    padding-bottom: var(--s-2);
    white-space: pre-line;
  }
</style>
