---
/**
 * Lieu de la pratique : indications d'accès (contenu fourni, facultatif), coordonnées GPS en texte et lien Google Maps,
 * construits depuis les coordonnées reçues (réglages « Lieu de la pratique »).
 */
import { coordonneesFr, lienCarte, type Gps } from '../lib/carte';

interface Props {
  gps: Gps;
}

const { gps } = Astro.props;
---

<div class="lieu">
  <p class="lieu__titre">Le lieu</p>
  <slot />
  <p class="lieu__gps">
    Coordonnées GPS : <span class="lieu__coordonnees">{coordonneesFr(gps)}</span>
  </p>
  <a class="lieu__lien" href={lienCarte(gps)} target="_blank" rel="noopener noreferrer">
    Ouvrir dans Google Maps <span class="lieu__aide">(s’ouvre dans un nouvel onglet)</span>
  </a>
</div>

<style>
  .lieu {
    max-width: var(--mesure);
    margin-top: var(--s-6);
    padding-top: var(--s-3);
    border-top: 1px solid var(--filet);
  }

  .lieu__titre {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--encre-doux);
  }

  .lieu :global(.prose) {
    margin-top: var(--s-1);
  }

  .lieu__gps {
    margin-top: var(--s-1);
  }

  .lieu__coordonnees {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .lieu__lien {
    display: inline-block;
    margin-top: var(--s-1);
    font-weight: 600;
  }

  .lieu__aide {
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--encre-doux);
  }
</style>
