---
/**
 * Lieu de la pratique (réglages « Lieu de la pratique ») : indications d'accès (contenu fourni, facultatif), coordonnées
 * GPS en texte et lien Google Maps, construits depuis les coordonnées reçues.
 * Avec un autre lieu (par exemple par mauvais temps) : deux encadrés « l'un ou l'autre », chacun avec son titre, son
 * icône, ses indications et son lien vers la carte (seulement si ses coordonnées sont données).
 */
import { coordonneesFr, lienCarte, type Gps } from '../lib/carte';
import IconeTrait from './IconeTrait.astro';

export interface AutreLieu {
  /** Titre de l'encadré (« Par mauvais temps »). */
  titre: string;
  nom: string;
  paragraphes: string[];
  gps?: Gps | undefined;
}

interface Props {
  gps: Gps;
  /** Titre du bloc et texte du lien (réglages « Petits textes du site »). */
  titre: string;
  lien: string;
  /** Titre de l'encadré du lieu habituel, affiché seulement s'il y a un autre lieu (« Par beau temps »). */
  titreHabituel: string;
  autre?: AutreLieu | undefined;
}

const { gps, titre, lien, titreHabituel, autre } = Astro.props;
---

<div class="lieu" id="lieu">
  <p class="lieu__titre">{titre}</p>
  {
    autre ? (
      <div class="lieux">
        <section class="lieu-carte" id="lieu-habituel">
          <h3 class="lieu-carte__titre">
            <IconeTrait nom="soleil" class="lieu-carte__icone">
              <circle cx="24" cy="24" r="8" />
              <path d="M24 6v6M24 36v6M6 24h6M36 24h6M11.3 11.3l4.2 4.2M32.5 32.5l4.2 4.2M11.3 36.7l4.2-4.2M32.5 15.5l4.2-4.2" />
            </IconeTrait>
            {titreHabituel}
          </h3>
          <slot />
          <p class="lieu__gps">
            Coordonnées GPS : <span class="lieu__coordonnees">{coordonneesFr(gps)}</span>
          </p>
          <a class="lieu__lien" href={lienCarte(gps)} target="_blank" rel="noopener noreferrer">
            {lien} <span class="lieu__aide">(s’ouvre dans un nouvel onglet)</span>
          </a>
        </section>
        <section class="lieu-carte lieu-carte--autre" id="lieu-autre">
          <h3 class="lieu-carte__titre">
            <IconeTrait nom="pluie" class="lieu-carte__icone">
              <path d="M14 30a8 8 0 0 1-.6-16 11 11 0 0 1 21 2.2A7 7 0 0 1 34 30z" />
              <path d="M17 35l-2 5M25 35l-2 5M33 35l-2 5" />
            </IconeTrait>
            {autre.titre}
          </h3>
          <p class="lieu-carte__nom">{autre.nom}</p>
          {autre.paragraphes.map((p) => (
            <p class="lieu-carte__texte">{p}</p>
          ))}
          {autre.gps && (
            <p class="lieu__gps">
              Coordonnées GPS : <span class="lieu__coordonnees">{coordonneesFr(autre.gps)}</span>
            </p>
          )}
          {autre.gps && (
            <a class="lieu__lien" href={lienCarte(autre.gps)} target="_blank" rel="noopener noreferrer">
              {lien} <span class="lieu__aide">(s’ouvre dans un nouvel onglet)</span>
            </a>
          )}
        </section>
      </div>
    ) : (
      <>
        <slot />
        <p class="lieu__gps">
          Coordonnées GPS : <span class="lieu__coordonnees">{coordonneesFr(gps)}</span>
        </p>
        <a class="lieu__lien" href={lienCarte(gps)} target="_blank" rel="noopener noreferrer">
          {lien} <span class="lieu__aide">(s’ouvre dans un nouvel onglet)</span>
        </a>
      </>
    )
  }
</div>

<style>
  .lieu {
    max-width: var(--mesure);
    margin-top: var(--s-6);
    padding-top: var(--s-3);
    border-top: 1px solid var(--filet);
  }

  .lieu__titre {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--encre-doux);
  }

  .lieu :global(.prose) {
    margin-top: var(--s-1);
  }

  .lieu__gps {
    margin-top: var(--s-1);
  }

  .lieu__coordonnees {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .lieu__lien {
    display: inline-block;
    margin-top: var(--s-1);
    font-weight: 600;
  }

  .lieu__aide {
    font-size: var(--fs-xs);
    font-weight: 400;
    color: var(--encre-doux);
  }

  /* ---------- Deux lieux : encadrés « l'un ou l'autre », l'un sous l'autre ---------- */
  .lieux {
    display: grid;
    gap: var(--s-2);
    margin-top: var(--s-2);
  }

  .lieu-carte {
    padding: var(--s-3);
    border: 1px solid color-mix(in srgb, var(--dore) 35%, transparent);
    border-radius: var(--r-3);
    background-color: color-mix(in srgb, var(--blanc) 55%, var(--creme));
    overflow-wrap: anywhere;
  }

  .lieu-carte--autre {
    background-color: color-mix(in srgb, var(--rose-doux) 30%, var(--creme));
  }

  .lieu-carte__titre {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--police-titre);
    font-size: var(--fs-lg);
    font-weight: 600;
    color: var(--foret);
  }

  .lieu-carte :global(.lieu-carte__icone) {
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    color: var(--dore);
  }

  .lieu-carte--autre :global(.lieu-carte__icone) {
    color: var(--rose-fonce);
  }

  .lieu-carte__nom {
    margin-top: var(--s-1);
    font-weight: 600;
  }

  .lieu-carte__texte {
    margin-top: 0.5rem;
  }
</style>
