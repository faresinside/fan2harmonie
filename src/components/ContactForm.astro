---
/**
 * Contact : quelques mots de Stéphanie et l'adresse e-mail, puis le formulaire sur une carte crème.
 * Formulaire envoyé au script PHP du même hébergement (`site.formEndpoint` = /api/contact.php, voir
 * public/api/) : POST classique sans JavaScript, envoi en arrière-plan avec (src/scripts/contact.ts).
 * Validation native du navigateur (pas de « novalidate ») ; après une saisie invalide, une courte indication
 * écrite s'affiche sous le champ, en plus de la couleur. Longueurs maximales identiques à celles du script.
 * Anti-spam : champ piège « _gotcha », hors écran, ignoré au clavier et par les lecteurs d'écran ; un robot qui
 * le remplit reçoit un faux succès et son message n'est pas envoyé. Le sujet de l'e-mail est composé par le
 * script (aucun champ « _subject »).
 * RGPD : consentement obligatoire, finalité unique (répondre), détails dans /mentions-legales/.
 */
import { site } from '../config/site';
import { lienMailto } from '../lib/contact';
import IconSouffle from './IconSouffle.astro';

const mailto = lienMailto(site.email);
---

<div class="contact">
  <div class="contact__mot">
    <p class="contact__invitation">Si besoin, n’hésitez pas à me contacter.</p>
    <p class="contact__reponse">Je vous réponds dès que possible.</p>
    <p class="contact__email">
      <span class="contact__email-libelle">Par e-mail</span>
      <a href={mailto}>{site.email}</a>
    </p>
    <IconSouffle />
  </div>

  <div class="contact__carte">
    <form class="formulaire" action={site.formEndpoint} method="post" data-contact>
      <p class="formulaire__note">Tous les champs sont obligatoires.</p>

      <div class="formulaire__ligne">
        <div class="champ">
          <label class="champ__libelle" for="contact-nom">Votre nom</label>
          <input class="champ__saisie" id="contact-nom" name="nom" type="text" maxlength="100" autocomplete="name" aria-describedby="contact-nom-aide" required />
          <p class="champ__aide" id="contact-nom-aide">Indiquez votre nom.</p>
        </div>

        <div class="champ">
          <label class="champ__libelle" for="contact-email">Votre adresse e-mail</label>
          <input
            class="champ__saisie"
            id="contact-email"
            name="email"
            type="email"
            maxlength="254"
            autocomplete="email"
            inputmode="email"
            spellcheck="false"
            aria-describedby="contact-email-aide"
            required
          />
          <p class="champ__aide" id="contact-email-aide">Indiquez une adresse e-mail valide, par exemple nom@exemple.fr.</p>
        </div>
      </div>

      <div class="champ">
        <label class="champ__libelle" for="contact-message">Votre message</label>
        <textarea class="champ__saisie champ__saisie--message" id="contact-message" name="message" rows="6" maxlength="5000" aria-describedby="contact-message-aide" required
        ></textarea>
        <p class="champ__aide" id="contact-message-aide">Écrivez votre message.</p>
      </div>

      <!-- Champ piège : invisible et inatteignable pour une personne, rempli par les robots. -->
      <div class="formulaire__piege" aria-hidden="true">
        <label for="contact-gotcha">Ne pas remplir ce champ</label>
        <input id="contact-gotcha" name="_gotcha" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="champ champ--case">
        <input
          class="champ__case"
          id="contact-consentement"
          name="consentement"
          type="checkbox"
          value="oui"
          aria-describedby="contact-consentement-aide contact-consentement-precision"
          required
        />
        <label class="champ__libelle-case" for="contact-consentement">
          J’accepte que mon nom, mon adresse e-mail et mon message soient utilisés uniquement pour répondre à ma
          demande.
        </label>
        <p class="champ__aide" id="contact-consentement-aide">Cochez cette case pour pouvoir envoyer votre message.</p>
        <p class="champ__precision" id="contact-consentement-precision">
          Ces informations ne sont conservées que le temps de répondre à ma demande. En savoir plus :
          <a href="/mentions-legales/#donnees-personnelles">données personnelles</a>.
        </p>
      </div>

      <div class="formulaire__envoi">
        <button class="bouton bouton--rose formulaire__bouton" type="submit">
          <span data-libelle>Envoyer mon message</span>
        </button>
        <!-- Zones annoncées par les lecteurs d'écran : présentes dès le chargement, vides jusqu'à l'envoi. -->
        <p class="formulaire__retour formulaire__retour--succes" role="status" aria-live="polite" tabindex="-1" data-succes></p>
        <div class="formulaire__retour formulaire__retour--erreur" role="alert" tabindex="-1" data-erreur></div>
      </div>

      <!--
        Textes des retours, copiés par le script dans les zones ci-dessus (masqués d'ici là).
        Pas de <template> : le compilateur d'Astro y dédouble les liens.
      -->
      <div hidden data-modele-succes>Merci, votre message est bien parti. Je vous répondrai dès que possible.</div>
      <div hidden data-modele-erreur>
        <p>
          <strong>Le message n’a pas pu être envoyé.</strong> Vous pouvez réessayer, ou m’écrire directement à
          <a href={mailto}>{site.email}</a>.
        </p>
      </div>
    </form>
  </div>
</div>

<script>
  import '../scripts/contact';
</script>

<style>
  .contact {
    display: grid;
    gap: var(--s-5);
    max-width: 62rem;
    margin-inline: auto;
    text-align: left;
  }

  /* ---------- Quelques mots ---------- */
  .contact__mot {
    text-align: center;
  }

  .contact__invitation {
    font-family: var(--police-titre);
    font-size: var(--fs-h3);
    font-style: italic;
    font-weight: 500;
    line-height: 1.3;
    color: var(--foret);
  }

  .contact__reponse {
    margin-top: var(--s-1);
    color: var(--encre-doux);
  }

  .contact__email {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    margin-top: var(--s-3);
    padding-top: var(--s-3);
    background: var(--trait-onde) top center / min(14rem, 80%) 6px no-repeat;
  }

  .contact__email-libelle {
    font-size: var(--fs-xs);
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--encre-doux);
  }

  .contact__email a {
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* Souffle dessiné : illustration de grand écran seulement, comme dans les autres sections. */
  .contact__mot :global(.icone) {
    display: none;
  }

  /* ---------- Carte du formulaire ---------- */
  .contact__carte {
    padding: var(--s-4) var(--s-3);
    border: 1px solid color-mix(in srgb, var(--dore) 35%, transparent);
    border-radius: var(--r-3);
    background-color: color-mix(in srgb, var(--blanc) 55%, var(--creme));
    box-shadow: var(--ombre-douce);
  }

  .formulaire {
    position: relative;
    display: grid;
    gap: var(--s-3);
  }

  .formulaire__note {
    font-size: var(--fs-xs);
    color: var(--encre-doux);
  }

  .formulaire__ligne {
    display: grid;
    gap: var(--s-3);
  }

  .champ {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.375rem;
    min-width: 0;
  }

  .champ__libelle {
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--foret);
  }

  .champ__saisie {
    width: 100%;
    min-height: 3rem;
    padding: 0.625rem 0.875rem;
    border: 1px solid var(--bordure-champ);
    border-radius: var(--r-2);
    background-color: var(--blanc);
    color: var(--encre);
    line-height: 1.4;
    transition:
      border-color var(--duree-rapide) var(--ease-sortie),
      box-shadow var(--duree-rapide) var(--ease-sortie);
  }

  .champ__saisie--message {
    min-height: 9rem;
    resize: vertical;
    line-height: var(--lh-texte);
  }

  .champ__saisie:hover {
    border-color: var(--foret);
  }

  /* Focus : anneau vert forêt (le rose foncé est réservé aux erreurs) et halo rose très doux. */
  .champ__saisie:focus-visible {
    outline-color: var(--foret);
    outline-offset: 2px;
    border-color: var(--foret);
    box-shadow: 0 0 0 4px var(--rose-doux);
  }

  /*
   * Saisie invalide (après interaction seulement) : contour rose foncé et indication écrite.
   * Sans JavaScript : `:user-invalid`. Avec : le script pose aria-invalid="true" (annoncé par les lecteurs d'écran)
   * et marque le formulaire [data-validation] ; seul aria-invalid compte alors (pas de décalage pendant un clic).
   */
  .formulaire:not([data-validation]) .champ__saisie:user-invalid,
  .champ__saisie[aria-invalid='true'] {
    border-color: var(--rose-fonce);
    box-shadow: inset 0 0 0 1px var(--rose-fonce);
  }

  /*
   * Indication reliée au champ par aria-describedby : toujours dans l'arbre d'accessibilité (jamais display:none),
   * visuellement masquée tant que le champ n'est pas en erreur.
   */
  .champ__aide {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--rose-fonce);
  }

  .champ__aide::before {
    content: '';
    display: inline-block;
    width: 0.5em;
    height: 0.5em;
    margin-right: 0.5em;
    border: 1.5px solid currentColor;
    border-radius: 50%;
    vertical-align: 0.1em;
  }

  .formulaire:not([data-validation]) .champ:has(:user-invalid) .champ__aide,
  .champ:has([aria-invalid='true']) .champ__aide {
    position: static;
    width: auto;
    height: auto;
    margin: 0;
    overflow: visible;
    clip: auto;
    white-space: normal;
  }

  /* ---------- Consentement ---------- */
  .champ--case {
    grid-template-columns: auto minmax(0, 1fr);
    align-items: start;
    column-gap: 0.75rem;
    padding-top: var(--s-2);
    border-top: 1px solid var(--filet);
  }

  .champ__case {
    width: 1.25rem;
    height: 1.25rem;
    margin-top: 0.2rem;
    accent-color: var(--foret);
    cursor: pointer;
  }

  .formulaire:not([data-validation]) .champ__case:user-invalid,
  .champ__case[aria-invalid='true'] {
    outline: 2px solid var(--rose-fonce);
    outline-offset: 2px;
  }

  .champ__libelle-case {
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--encre);
    cursor: pointer;
  }

  .champ--case .champ__aide,
  .champ__precision {
    grid-column: 2;
  }

  .champ__precision {
    font-size: var(--fs-xs);
    color: var(--encre-doux);
  }

  /* ---------- Champ piège : hors écran, sans display:none (que certains robots savent repérer) ---------- */
  .formulaire__piege {
    position: absolute;
    left: -9999px;
    top: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  /* ---------- Envoi et retours ---------- */
  .formulaire__envoi {
    display: flex;
    flex-direction: column;
    align-items: stretch;
  }

  .formulaire__bouton:disabled {
    cursor: progress;
    background-color: var(--rose-fonce);
    box-shadow: none;
  }

  /* Les messages reçoivent le focus après l'envoi : anneau un peu écarté de leur bordure. */
  .formulaire__retour:focus-visible {
    outline-offset: 4px;
  }

  .formulaire__retour:not(:empty) {
    margin-top: var(--s-3);
    padding: var(--s-2) var(--s-3);
    border-radius: var(--r-2);
    font-size: var(--fs-sm);
    line-height: 1.5;
  }

  .formulaire__retour--succes:not(:empty) {
    border: 1px solid color-mix(in srgb, var(--foret) 30%, transparent);
    background-color: var(--blanc);
    font-family: var(--police-titre);
    font-size: var(--fs-lg);
    font-style: italic;
    font-weight: 500;
    text-align: center;
    color: var(--foret);
  }

  .formulaire__retour--erreur:not(:empty) {
    border: 1px solid color-mix(in srgb, var(--rose-fonce) 45%, transparent);
    background-color: var(--rose-doux);
    color: var(--encre);
  }

  .formulaire__retour--erreur a {
    color: var(--encre);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* ---------- Grand écran : les mots à gauche, la carte à droite ---------- */
  @media (min-width: 40rem) {
    .contact__carte {
      padding: var(--s-5);
    }

    .formulaire__ligne {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .formulaire__envoi {
      align-items: flex-start;
    }

    .formulaire__retour:not(:empty) {
      align-self: stretch;
    }
  }

  @media (min-width: 60rem) {
    .contact {
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.4fr);
      gap: var(--s-8);
      align-items: start;
    }

    .contact__mot {
      padding-top: var(--s-6);
      text-align: left;
    }

    .contact__email {
      align-items: flex-start;
      background-position: top left;
    }

    .contact__mot :global(.icone) {
      display: block;
      margin-top: var(--s-6);
      color: var(--foret-doux);
      --taille-icone: 6.5rem;
    }
  }
</style>
