---
/**
 * En-tête collant : logo, navigation, bouton de menu mobile.
 * Amélioration progressive : par défaut la navigation est visible (repliée sur plusieurs lignes) et le bouton masqué.
 * Le script qui branche le bouton pose ensuite la classe « js » sur <html> : alors seulement, sur mobile,
 * le bouton apparaît et la navigation devient un panneau déroulant. Script absent ou en échec : navigation visible.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo.png';

interface Props {
  /** Faux quand il n'y a aucune actualité : la section est retirée de la page, le lien aussi. */
  actualites?: boolean;
  /**
   * Faux sur les autres pages (mentions légales) : les liens visent alors les sections de l'accueil
   * (« /#rdv ») au lieu d'ancres de la page courante (« #rdv »).
   */
  surAccueil?: boolean;
}

const { actualites = true, surAccueil = true } = Astro.props;
const prefixe = surAccueil ? '' : '/';

const liens = [
  { ancre: 'rdv', libelle: 'Rendez-vous' },
  { ancre: 'pratique', libelle: 'La pratique' },
  { ancre: 'qigong', libelle: 'Le Qi Gong' },
  { ancre: 'qui', libelle: 'Qui est Fan 2 Harmonie' },
  { ancre: 'actualites', libelle: 'Actualités' },
  { ancre: 'contact', libelle: 'Contact' },
]
  .filter(({ ancre }) => actualites || ancre !== 'actualites')
  .map(({ ancre, libelle }) => ({ href: `${prefixe}#${ancre}`, libelle }));
---

<header class="entete" data-entete>
  <div class="entete__barre container">
    <a class="entete__marque" href={surAccueil ? '#accueil' : '/'}>
      <Image src={logo} alt="" width={64} class="entete__logo" loading="eager" />
      <span class="entete__nom">Fan 2 Harmonie</span>
    </a>

    <button class="entete__bouton" type="button" aria-expanded="false" aria-controls="menu-principal">
      <span class="entete__bouton-icone" aria-hidden="true"><span></span></span>
      <span class="entete__bouton-libelle">Menu</span>
    </button>

    <nav id="menu-principal" class="entete__nav" aria-label="Navigation principale">
      <ul class="entete__liens" role="list">
        {
          liens.map(({ href, libelle }) => (
            <li>
              <a href={href}>{libelle}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<!--
  Script classique en ligne, exécuté de façon synchrone juste après l'en-tête : le menu est replié
  avant la première peinture (pas de flash ni de décalage). Il branche le bouton et ne pose la
  classe « js » qu'en dernier, si tout a fonctionné ; sinon la navigation reste visible.
-->
<script is:inline>
  (() => {
    const entete = document.querySelector('[data-entete]');
    const bouton = entete && entete.querySelector('button[aria-controls]');
    const nav = bouton && document.getElementById(bouton.getAttribute('aria-controls') || '');
    if (!entete || !bouton || !nav) return;

    const estOuvert = () => bouton.getAttribute('aria-expanded') === 'true';
    const basculer = (ouvert) => {
      bouton.setAttribute('aria-expanded', String(ouvert));
      entete.toggleAttribute('data-ouvert', ouvert);
    };

    // <button> natif : Entrée et Espace déclenchent « click ».
    bouton.addEventListener('click', () => basculer(!estOuvert()));

    // Un lien choisi : le menu se referme, le focus suit l'ancre (navigation normale).
    nav.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) basculer(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && estOuvert()) {
        basculer(false);
        bouton.focus();
      }
    });

    document.documentElement.classList.add('js');
  })();
</script>

<style>
  /* Collant seulement quand il est compact : avec le menu replié (JS) ou sur grand écran. */
  .entete {
    position: relative;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--creme) 92%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--dore) 30%, transparent);
  }

  .entete__barre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1) var(--s-3);
    min-height: var(--hauteur-entete);
  }

  /*
   * Base nulle : la marque ne pousse jamais le bouton sur une seconde ligne, même avant le chargement
   * d'Allura (la police de repli, plus large, provoquait un décalage de mise en page au chargement).
   */
  .entete__marque {
    flex: 1 1 0;
    min-width: 0;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding-block: 0.375rem;
    color: var(--foret);
    text-decoration: none;
  }

  .entete__logo {
    width: 2.5rem;
  }

  .entete__nom {
    font-family: var(--police-script);
    font-size: 1.875rem;
    line-height: 1;
    padding-top: 0.2em;
  }

  /* Bouton de menu : deux traits fins qui se croisent à l'ouverture. */
  .entete__bouton {
    display: none;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--foret) 35%, transparent);
    border-radius: var(--r-pilule);
    background: transparent;
    color: var(--foret);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .entete__bouton-icone {
    position: relative;
    display: block;
    width: 1.125rem;
    height: 0.625rem;
  }

  .entete__bouton-icone::before,
  .entete__bouton-icone::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition: transform var(--duree) var(--ease-souffle);
  }

  .entete__bouton-icone::before {
    top: 0;
  }

  .entete__bouton-icone::after {
    bottom: 0;
    width: 70%;
  }

  [data-ouvert] .entete__bouton-icone::before {
    transform: translateY(0.28rem) rotate(40deg);
  }

  [data-ouvert] .entete__bouton-icone::after {
    width: 100%;
    transform: translateY(-0.28rem) rotate(-40deg);
  }

  .entete__liens {
    list-style: none;
    padding: 0;
  }

  .entete__liens a {
    display: block;
    color: var(--foret);
    text-decoration: none;
  }

  .entete__liens a:hover {
    color: var(--rose-fonce);
  }

  /* ---------- Par défaut (sans JavaScript ou script en échec) : liens visibles, repliés sur plusieurs lignes ---------- */
  .entete__nav {
    flex-basis: 100%;
    padding-bottom: var(--s-1);
  }

  .entete__nav .entete__liens {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-2);
  }

  .entete__nav .entete__liens a {
    padding: 0.375rem 0;
    font-size: var(--fs-sm);
    font-weight: 500;
  }

  /*
   * ---------- Mobile, une fois le menu branché : panneau déroulant ----------
   * La classe « js » est posée sur <html> par le script qui branche le bouton, et seulement s'il a réussi.
   */
  @media (max-width: 63.99rem) {
    :global(.js) .entete {
      position: sticky;
    }

    :global(.js) .entete__bouton {
      display: inline-flex;
    }

    :global(.js) .entete__nav {
      display: none;
      padding-bottom: var(--s-3);
    }

    :global(.js) [data-ouvert] .entete__nav {
      display: block;
    }

    :global(.js) .entete__nav .entete__liens {
      display: block;
    }

    :global(.js) .entete__nav .entete__liens li + li {
      border-top: 1px solid color-mix(in srgb, var(--dore) 28%, transparent);
    }

    :global(.js) .entete__nav .entete__liens a {
      padding: 0.75rem 0.25rem;
      font-family: var(--police-titre);
      font-size: 1.375rem;
      font-weight: 600;
    }
  }

  @media (max-width: 63.99rem) and (prefers-reduced-motion: no-preference) {
    :global(.js) [data-ouvert] .entete__nav {
      animation: deroule var(--duree) var(--ease-sortie);
    }
  }

  @keyframes deroule {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  /* ---------- Grand écran : liens en ligne ---------- */
  @media (min-width: 64rem) {
    .entete {
      position: sticky;
    }

    .entete__nav {
      flex-basis: auto;
      padding: 0;
    }

    .entete__nav .entete__liens {
      gap: var(--s-4);
    }

    .entete__nav .entete__liens a {
      position: relative;
      padding: 0.5rem 0;
      letter-spacing: 0.02em;
    }

    /* Soulignement fin qui se déploie depuis le centre. */
    .entete__nav .entete__liens a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0.2rem;
      height: 1px;
      background: var(--rose);
      transform: scaleX(0);
      transition: transform var(--duree) var(--ease-souffle);
    }

    .entete__nav .entete__liens a:hover::after {
      transform: scaleX(1);
    }
  }
</style>
