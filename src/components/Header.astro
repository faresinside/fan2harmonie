---
/**
 * En-tête collant : logo, navigation, bouton de menu mobile.
 * Amélioration progressive : sans JavaScript (@media (scripting: none)), le bouton disparaît
 * et la navigation s'affiche en entier, repliée sur plusieurs lignes.
 */
import { Image } from 'astro:assets';
import logo from '../assets/logo/logo.png';

const liens = [
  { href: '#rdv', libelle: 'Rendez-vous' },
  { href: '#pratique', libelle: 'La pratique' },
  { href: '#qigong', libelle: 'Le Qi Gong' },
  { href: '#qui', libelle: 'Qui est Fan 2 Harmonie' },
  { href: '#actualites', libelle: 'Actualités' },
  { href: '#contact', libelle: 'Contact' },
];
---

<header class="entete" data-entete>
  <div class="entete__barre container">
    <a class="entete__marque" href="#accueil">
      <Image src={logo} alt="" width={64} class="entete__logo" loading="eager" />
      <span class="entete__nom">Fan 2 Harmonie</span>
    </a>

    <button class="entete__bouton" type="button" aria-expanded="false" aria-controls="menu-principal">
      <span class="entete__bouton-icone" aria-hidden="true"><span></span></span>
      <span class="entete__bouton-libelle">Menu</span>
    </button>

    <nav id="menu-principal" class="entete__nav" aria-label="Navigation principale">
      <ul class="entete__liens" role="list">
        {
          liens.map(({ href, libelle }) => (
            <li>
              <a href={href}>{libelle}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const entete = document.querySelector<HTMLElement>('[data-entete]');
  const bouton = entete?.querySelector<HTMLButtonElement>('button[aria-controls]');
  const nav = bouton ? document.getElementById(bouton.getAttribute('aria-controls') ?? '') : null;

  if (entete && bouton && nav) {
    const estOuvert = () => bouton.getAttribute('aria-expanded') === 'true';
    const basculer = (ouvert: boolean) => {
      bouton.setAttribute('aria-expanded', String(ouvert));
      entete.toggleAttribute('data-ouvert', ouvert);
    };

    // <button> natif : Entrée et Espace déclenchent « click ».
    bouton.addEventListener('click', () => basculer(!estOuvert()));

    // Un lien choisi : le menu se referme, le focus suit l'ancre (navigation normale).
    nav.addEventListener('click', (e) => {
      if (e.target instanceof Element && e.target.closest('a')) basculer(false);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && estOuvert()) {
        basculer(false);
        bouton.focus();
      }
    });
  }
</script>

<style>
  .entete {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: color-mix(in srgb, var(--creme) 92%, transparent);
    border-bottom: 1px solid color-mix(in srgb, var(--dore) 30%, transparent);
  }

  .entete__barre {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-1) var(--s-3);
    min-height: var(--hauteur-entete);
  }

  .entete__marque {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding-block: 0.375rem;
    color: var(--foret);
    text-decoration: none;
  }

  .entete__logo {
    width: 2.5rem;
  }

  .entete__nom {
    font-family: var(--police-script);
    font-size: 1.875rem;
    line-height: 1;
    padding-top: 0.2em;
  }

  /* Bouton de menu : deux traits fins qui se croisent à l'ouverture. */
  .entete__bouton {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    border: 1px solid color-mix(in srgb, var(--foret) 35%, transparent);
    border-radius: var(--r-pilule);
    background: transparent;
    color: var(--foret);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: 0.06em;
    cursor: pointer;
  }

  .entete__bouton-icone {
    position: relative;
    display: block;
    width: 1.125rem;
    height: 0.625rem;
  }

  .entete__bouton-icone::before,
  .entete__bouton-icone::after {
    content: '';
    position: absolute;
    left: 0;
    width: 100%;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition: transform var(--duree) var(--ease-souffle);
  }

  .entete__bouton-icone::before {
    top: 0;
  }

  .entete__bouton-icone::after {
    bottom: 0;
    width: 70%;
  }

  [data-ouvert] .entete__bouton-icone::before {
    transform: translateY(0.28rem) rotate(40deg);
  }

  [data-ouvert] .entete__bouton-icone::after {
    width: 100%;
    transform: translateY(-0.28rem) rotate(-40deg);
  }

  .entete__liens {
    list-style: none;
    padding: 0;
  }

  .entete__liens a {
    display: block;
    color: var(--foret);
    text-decoration: none;
  }

  .entete__liens a:hover {
    color: var(--rose-fonce);
  }

  /* ---------- Mobile (avec JavaScript) : panneau déroulant ---------- */
  .entete__nav {
    display: none;
    flex-basis: 100%;
    padding-bottom: var(--s-3);
  }

  [data-ouvert] .entete__nav {
    display: block;
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-ouvert] .entete__nav {
      animation: deroule var(--duree) var(--ease-sortie);
    }
  }

  @keyframes deroule {
    from {
      opacity: 0;
      transform: translateY(-0.5rem);
    }
  }

  .entete__nav .entete__liens li + li {
    border-top: 1px solid color-mix(in srgb, var(--dore) 28%, transparent);
  }

  .entete__nav .entete__liens a {
    padding: 0.75rem 0.25rem;
    font-family: var(--police-titre);
    font-size: 1.375rem;
    font-weight: 600;
  }

  /* ---------- Sans JavaScript : navigation visible, repliée ---------- */
  @media (scripting: none) {
    .entete {
      position: relative;
    }

    .entete__bouton {
      display: none;
    }

    .entete__nav {
      display: block;
      padding-bottom: var(--s-1);
    }

    .entete__nav .entete__liens {
      display: flex;
      flex-wrap: wrap;
      gap: 0 var(--s-2);
    }

    .entete__nav .entete__liens li + li {
      border-top: 0;
    }

    .entete__nav .entete__liens a {
      padding: 0.375rem 0;
      font-family: var(--police-texte);
      font-size: var(--fs-sm);
    }
  }

  /* ---------- Grand écran : liens en ligne ---------- */
  @media (min-width: 64rem) {
    .entete__bouton {
      display: none;
    }

    .entete__nav,
    [data-ouvert] .entete__nav {
      display: block;
      flex-basis: auto;
      padding: 0;
      animation: none;
    }

    .entete__nav .entete__liens {
      display: flex;
      gap: var(--s-4);
    }

    .entete__nav .entete__liens li + li {
      border-top: 0;
    }

    .entete__nav .entete__liens a {
      position: relative;
      padding: 0.5rem 0;
      font-family: var(--police-texte);
      font-size: var(--fs-sm);
      font-weight: 500;
      letter-spacing: 0.02em;
    }

    /* Soulignement fin qui se déploie depuis le centre. */
    .entete__nav .entete__liens a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0.2rem;
      height: 1px;
      background: var(--rose);
      transform: scaleX(0);
      transition: transform var(--duree) var(--ease-souffle);
    }

    .entete__nav .entete__liens a:hover::after {
      transform: scaleX(1);
    }
  }
</style>
