---
/** Ornement entre deux sections : deux traits ondoyants et un bouton de lotus, au trait du logo. Décoratif. */
interface Props {
  class?: string | undefined;
}

const { class: classe } = Astro.props;
---

<svg
  class:list={['separateur', classe]}
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 220 28"
  width="220"
  height="28"
  fill="none"
  stroke="currentColor"
  stroke-width="1.1"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path d="M6 16.5c14-2.6 27 1.4 41-.6 12-1.7 21-3.4 33-1.4 6 1 10 1.6 15 .9" />
  <path d="M214 16.5c-14-2.6-27 1.4-41-.6-12-1.7-21-3.4-33-1.4-6 1-10 1.6-15 .9" />
  <path d="M110 22.6c-4.6-3.6-4.4-11.2 0-17.4 4.4 6.2 4.6 13.8 0 17.4Z" />
  <path d="M108.6 23c-5.6-.6-8.8-5.3-8.3-11.6 2.6 1.2 4.4 2.8 5.3 5" />
  <path d="M111.4 23c5.6-.6 8.8-5.3 8.3-11.6-2.6 1.2-4.4 2.8-5.3 5" />
  <circle cx="110" cy="2.4" r=".6" fill="currentColor" stroke="none" />
</svg>

<style>
  .separateur {
    width: 13.75rem;
    max-width: 70%;
    height: auto;
    margin-inline: auto;
    color: var(--dore);
  }
</style>
