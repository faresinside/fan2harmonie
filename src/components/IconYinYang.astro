---
/** Yin-yang ouvert, tracé comme un cercle zen laissé entrouvert — « souplesse ». */
import IconeTrait, { type IconeProps } from './IconeTrait.astro';

type Props = IconeProps;
---

<IconeTrait nom="yinyang" {...Astro.props}>
  <g transform="rotate(-20 24 24)">
    <path d="M10.1 32A16 16 0 1 1 21.2 39.8" />
    <path d="M24 8c4.4 0 8 3.6 8 8s-3.6 8-8 8-8 3.6-8 8 3.6 8 8 8" />
    <circle cx="24" cy="16" r="1.6" />
    <circle cx="24" cy="32" r="1.6" fill="currentColor" />
  </g>
</IconeTrait>
