---
/**
 * Silhouette au trait — « travailler les muscles profonds ».
 * Un seul contour fluide, comme la femme du logo : bras levés qui se rejoignent en feuille au-dessus
 * de la tête, taille fine, base évasée en jupe.
 */
import IconeTrait, { type IconeProps } from './IconeTrait.astro';

type Props = IconeProps;
---

<IconeTrait nom="silhouette" {...Astro.props}>
  <path
    d="M10.4 40.5C14.6 35.5 19.3 31 20.9 27.5 21.9 25 21.1 23 20.6 20.5 15.6 17.5 15.2 10.5 24 4.5 32.8 10.5 32.4 17.5 27.4 20.5 26.9 23 26.1 25 27.1 27.5 28.7 31 33.4 35.5 37.6 40.5 29.2 38.8 18.8 38.8 10.4 40.5Z"
  />
  <ellipse cx="24" cy="13.6" rx="2.6" ry="3" />
  <path d="M24 30.2c-.5 3.2-.3 6.2.5 9" />
</IconeTrait>
